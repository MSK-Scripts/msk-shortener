# ─── App ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# Öffentliche Basis-URL des Shorteners (für QR-Codes & Share-Links)
NEXT_PUBLIC_BASE_URL=https://s.msk-scripts.de

# ─── Datenbank (MariaDB) ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=msk_shortener
DB_PASSWORD=change_me_strong_password
DB_NAME=msk_shortener

# ─── Sicherheit ───────────────────────────────────────────────────────
# Für IP-Hashing (DSGVO-konforme Click-Tracking)
# Generieren mit:  openssl rand -hex 32
IP_HASH_SECRET=change_me_with_openssl_rand_hex_32

# Rate-Limit: Max. Link-Erstellungen pro IP / Stunde
RATE_LIMIT_CREATE_PER_HOUR=20

# ─── Spamschutz ───────────────────────────────────────────────────────
# Cloudflare Turnstile für das Formular. In Produktion PFLICHT: ohne beide
# Schlüssel kürzt das Formular dort nichts. Widget anlegen unter
# dash.cloudflare.com → Turnstile für s.msk-scripts.de. Für lokale Tests
# bestehen Cloudflares Testschlüssel immer:
#   Site-Key 1x00000000000000000000AA, Secret 1x0000000000000000000000000000000AA
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# Links, die eine IP über das Formular in 24 Stunden kürzen darf
DAILY_LINKS_PER_IP=20

# Links, die ein API-Schlüssel pro Stunde kürzen darf (Schlüssel: scripts/api-key.sh)
API_KEY_CREATE_PER_HOUR=120

# ─── Short-Code Settings ──────────────────────────────────────────────
# Gültig sind 3 bis 16. Ungültige Werte fallen auf 7 zurück.
SHORTCODE_LENGTH=7
# Grenzen für selbst gewählte Codes, gültig sind 3 bis 20.
# Ungültige Werte fallen auf 3 bzw. 20 zurück.
SHORTCODE_MIN_CUSTOM=3
SHORTCODE_MAX_CUSTOM=20
